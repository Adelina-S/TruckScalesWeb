<style>
    /* Базовые стили кнопки */
    .weigh-button {
        min-width: 280px !important;
        width: 100% !important;
        height: 90px !important;
        background: linear-gradient(135deg, #007bff 0%, #0056b3 100%) !important;
        color: white !important;
        border: none !important;
        border-radius: 10px !important;
        font-size: 16px !important;
        font-weight: 600 !important;
        letter-spacing: 0.5px !important;
        box-shadow: 0 4px 15px rgba(0, 123, 255, 0.3) !important;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
        position: relative !important;
        overflow: hidden !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 10px !important;
        cursor: pointer !important;
    }

        /* Стандартный режим - hover эффекты */
        .weigh-button:not(.waiting):not(:disabled):hover {
            transform: translateY(-2px) !important;
            box-shadow: 0 6px 20px rgba(0, 123, 255, 0.4) !important;
            background: linear-gradient(135deg, #3395ff 0%, #006ee6 100%) !important;
        }

        .weigh-button:not(.waiting):not(:disabled):active {
            transform: translateY(0) !important;
            box-shadow: 0 2px 10px rgba(0, 123, 255, 0.3) !important;
        }

        /* Режим ожидания (взвешивание) */
        .weigh-button.waiting {
            background: linear-gradient(135deg, #ff9800 0%, #f57c00 100%) !important;
            box-shadow: 0 4px 15px rgba(255, 152, 0, 0.3) !important;
            cursor: wait !important;
        }

        /* Disabled режим */
        .weigh-button:disabled {
            background: linear-gradient(135deg, #6c757d 0%, #545b62 100%) !important;
            box-shadow: 0 4px 15px rgba(108, 117, 125, 0.3) !important;
            cursor: not-allowed !important;
            opacity: 0.7 !important;
        }

    /* Анимация загрузки */
    .spinning-icon {
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    /* Анимация волны для режима ожидания */
    .waiting::after {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
        animation: wave 1.5s infinite linear;
    }

    @@keyframes wave {
        from {
            left: -100%;
        }

        to {
            left: 100%;
        }
    }

    /* Пульсация для привлечения внимания */
    .weigh-button:not(:disabled):not(.waiting) {
        animation: subtlePulse 3s infinite;
    }

    @@keyframes subtlePulse {
        0%, 100% {
            box-shadow: 0 4px 15px rgba(0, 123, 255, 0.3);
        }

        50% {
            box-shadow: 0 4px 20px rgba(0, 123, 255, 0.5);
        }
    }

    /* Иконки */
    .button-icon {
        font-size: 20px !important;
    }

    .button-text {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
    }

    .main-text {
        font-size: 16px;
        font-weight: 600;
    }

    .sub-text {
        font-size: 12px;
        opacity: 0.9;
        font-weight: 400;
    }

    /* Адаптивность */
    @@media (max-width: 768px) {
        .weigh-button {
            min-width: 240px !important;
            height: 60px !important;
            font-size: 14px !important;
        }

        .main-text {
            font-size: 14px;
        }

        .sub-text {
            font-size: 11px;
        }
    }
</style>

<RadzenButton Click="HandleClick"
              class="@string.Format("{0} {1}","weigh-button", (IsWaiting ? "waiting" : ""))"
              Disabled="@IsDisabled"
              ButtonStyle="@ButtonStyle"
              Variant="Variant.Flat"
              Size="ButtonSize.Large">

    <div class="button-content">
        @if (IsWaiting)
        {
            <RadzenIcon Icon="@WaitingIcon" class="button-icon spinning-icon" />
        }
        else if (!string.IsNullOrEmpty(Icon))
        {
            <RadzenIcon Icon="@Icon" class="button-icon" />
        }

        <div class="button-text">
            <span class="main-text">@GetMainText()</span>
        </div>
    </div>

</RadzenButton>

@code {
    string Text { get; set; } = "ВЗВЕСИТЬ";
    string WaitingText { get; set; } = "ИДЕТ ВЗВЕШИВАНИЕ";
    string DisabledText { get; set; } = "ВЗВЕШИВАНИЕ НЕДОСТУПНО";
    string Icon { get; set; } = "scale";
    string WaitingIcon { get; set; } = "sync";
    string DisabledIcon { get; set; } = "block";

    [Parameter] public bool IsWaiting { get; set; }
    [Parameter] public bool IsDisabled { get; set; }

    [Parameter] public EventCallback OnClick { get; set; }

    [Parameter] public ButtonStyle ButtonStyle { get; set; } = ButtonStyle.Primary;

    private string GetMainText()
    {
        if (IsDisabled)
            return DisabledText;
        else if (IsWaiting)
            return WaitingText;
        else return Text;
    }

    private async Task HandleClick()
    {
        if (!IsDisabled && !IsWaiting)
        {
            await OnClick.InvokeAsync();
        }
    }

    // Методы для внешнего управления
    public void StartWeighing()
    {
        IsWaiting = true;
        StateHasChanged();
    }

    public void StopWeighing()
    {
        IsWaiting = false;
        StateHasChanged();
    }

    public async Task Enable()
    {
        await InvokeAsync(() =>
        {
            IsDisabled = false;
            StateHasChanged();
        });
    
    }

    public async Task Disable()
    {
        await InvokeAsync(() =>
        {
            IsDisabled = true;
            StateHasChanged();
        });
    }

    public void Reset()
    {
        IsWaiting = false;
        IsDisabled = false;
        StateHasChanged();
    }
}